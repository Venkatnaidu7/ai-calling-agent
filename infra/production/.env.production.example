# Production environment template. NEVER commit real secrets.
APP_ENV=production
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=replace-with-a-random-32+-character-secret
POSTGRES_USER=voice
POSTGRES_PASSWORD=replace-with-a-random-database-password
POSTGRES_DB=voice
DATABASE_URL=postgresql+asyncpg://voice:replace-with-a-random-database-password@postgres:5432/voice
REDIS_PASSWORD=replace-with-a-random-redis-password
REDIS_URL=redis://:replace-with-a-random-redis-password@redis:6379/0
PUBLIC_BASE_URL=https://api.example.com
FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com
REQUEST_MAX_BYTES=1048576
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AWS_REGION=ap-south-1
S3_BUCKET=
AWS_SECRETS_MANAGER_NAME=
OUTBOUND_ENABLED=false
RECORDING_MODE=DISABLED
