FRONTEND_URL=https://app.example.com
CORS_ORIGINS=https://app.example.com
TRUSTED_HOSTS=api.example.com
REQUEST_MAX_BYTES=1048576
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
